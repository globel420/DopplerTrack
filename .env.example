# Copy to .env and chmod 600 before `docker compose up`.
# These values are public identifiers, not credentials; the JWT itself is supplied by Cloudflare Access.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Whole-file cap; browser uploads are split into 32 MiB requests for Cloudflare.
MAX_UPLOAD_MB=4096
MAX_DURATION_SECONDS=3600
MAX_QUEUE=2
RETENTION_SECONDS=86400
ANALYSIS_TIMEOUT_SECONDS=7200
UPLOAD_SESSION_TTL_SECONDS=14400
MIN_FREE_DISK_GB=10

# Historical matching sends only a user's consented recording time and bounded
# search circle to adsb.aero. Enable only after reviewing provider service terms
# and operational capacity. Source tracks are from the ADSB.lol archive (ODbL 1.0).
ADSB_HISTORY_ENABLED=false
