FROM python:3.13.18-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system --gid 10001 dopplertrack \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin dopplertrack

WORKDIR /srv/dopplertrack
COPY --chown=10001:10001 app/__init__.py ./app/__init__.py
COPY --chown=10001:10001 app/egress_proxy.py ./app/egress_proxy.py
COPY --chown=10001:10001 app/url_security.py ./app/url_security.py

USER 10001:10001
EXPOSE 3128
CMD ["python", "-m", "app.egress_proxy"]
